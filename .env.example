# Copy to .env and fill in. .env is gitignored; this example file is not.

# xAI API key for the niche-filter assistant (POST /api/niche). Server-side only;
# never sent to the browser. Without it the app runs fully - the niche panel
# explains that the assistant is not configured.
XAI_API_KEY=

# Optional overrides.
# XAI_MODEL=grok-4.6
# XAI_API_URL=https://api.x.ai/v1/chat/completions

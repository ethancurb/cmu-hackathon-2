# Copy to .env.local. Keep actual values out of Git and chat.
AUTH0_ENABLED=false
AUTH0_ISSUER_BASE_URL=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# A separately generated random session secret (at least 32 characters).
AUTH0_SECRET=
# Production demo: 4173. For npm run dev, use 5173 instead.
AUTH0_BASE_URL=http://127.0.0.1:4173
